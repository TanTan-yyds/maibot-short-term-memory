{
  "manifest_version": 2,
  "id": "github.tantan-yyds.short-term-memory",
  "version": "1.0.2",
  "name": "短期记忆",
  "description": "全局短期记忆：在 Planner 与 Replyer 中注入 QQ 号、QQ 名和事情描述，并提供创建、修改、删除工具。",
  "author": {
    "name": "TanTanMao",
    "url": "https://github.com/TanTan-yyds"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/TanTan-yyds/maibot-short-term-memory",
    "homepage": "https://github.com/TanTan-yyds/maibot-short-term-memory",
    "documentation": "https://github.com/TanTan-yyds/maibot-short-term-memory/blob/main/README.md",
    "issues": "https://github.com/TanTan-yyds/maibot-short-term-memory/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.16.99"
  },
  "dependencies": [],
  "plugin_type": "data",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "brain"
    }
  },
  "capabilities": [
    "person.get_id",
    "person.get_value"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
